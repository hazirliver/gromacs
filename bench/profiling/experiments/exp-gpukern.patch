+/* THROWAWAY EXPERIMENT: GMX_EXP_SPREAD_REPLAY=first:every:count:reps:file replays the spline+spread
+ * kernel on the live coordinates of selected calls, isolated (PME stream synchronised), into a scratch
+ * grid: production order, interleaved warps, atoms sorted by coarse spatial cell (permutation computed
+ * on the host from the current coordinates), and sorted + interleaved. Times with CUDA events and
+ * compares the grids with the production-order grid. */
+struct ExpSpreadReplay
+{
+    bool        enabled = false;
+    long        first = 0, every = 1, count = 0, reps = 20, calls = 0, done = 0;
+    std::string file;
+};
+
+static ExpSpreadReplay& expSpreadReplay()
+{
+    static ExpSpreadReplay r = []()
+    {
+        ExpSpreadReplay x;
+        if (const char* e = std::getenv("GMX_EXP_SPREAD_REPLAY"))
+        {
+            char buf[1024];
+            std::snprintf(buf, sizeof(buf), "%s", e);
+            char* save = nullptr;
+            char* tok  = strtok_r(buf, ":", &save);
+            long  v[4] = { 0, 1, 0, 20 };
+            for (int i = 0; i < 4 && tok; i++, tok = strtok_r(nullptr, ":", &save))
+            {
+                v[i] = std::atol(tok);
+            }
+            x.first   = v[0];
+            x.every   = std::max(1L, v[1]);
+            x.count   = v[2];
+            x.reps    = std::max(1L, v[3]);
+            x.file    = tok ? tok : "spread_replay.txt";
+            x.enabled = x.count > 0;
+        }
+        return x;
+    }();
+    return r;
+}
+
+static void expSpreadReplayRun(PmeGpu*                            pmeGpu,
+                               PmeGpuProgramImpl::PmeKernelHandle kernelPtr,
+                               const KernelLaunchConfig&          config,
+                               const PmeGpuKernelParams*          kp)
+{
+    auto&        r      = expSpreadReplay();
+    cudaStream_t stream = pmeGpu->archSpecific->pmeStream_.stream();
+    cudaStreamSynchronize(stream);
+    const int    nAtoms   = kp->atoms.nAtoms;
+    const size_t gridSize = pmeGpu->archSpecific->realGridSize[0];
+    float*       d_grid   = nullptr;
+    int*         d_perm   = nullptr;
+    cudaMalloc(&d_grid, gridSize * sizeof(float));
+    cudaMalloc(&d_perm, std::max(1, nAtoms) * sizeof(int));
+    // permutation: sort atoms by a coarse spatial cell (4 PME grid lines per cell in each dimension)
+    std::vector<float> hx(3 * size_t(nAtoms));
+    cudaMemcpy(hx.data(), kp->atoms.d_coordinates, hx.size() * sizeof(float), cudaMemcpyDeviceToHost);
+    const auto& rb = kp->current.recipBox;
+    int         nc[DIM];
+    for (int d = 0; d < DIM; d++)
+    {
+        nc[d] = std::max(1, kp->grid.realGridSize[d] / 4);
+    }
+    std::vector<std::pair<long, int>> keys(nAtoms);
+    for (int i = 0; i < nAtoms; i++)
+    {
+        long key = 0;
+        const float x = hx[3 * i], y = hx[3 * i + 1], z = hx[3 * i + 2];
+        const float frac[DIM] = { x * rb[XX][XX] + y * rb[XX][YY] + z * rb[XX][ZZ],
+                                  y * rb[YY][YY] + z * rb[YY][ZZ],
+                                  z * rb[ZZ][ZZ] };
+        for (int d = 0; d < DIM; d++)
+        {
+            float f = frac[d];
+            f -= std::floor(f);
+            const int c = std::min(nc[d] - 1, std::max(0, int(f * nc[d])));
+            key         = key * nc[d] + c;
+        }
+        keys[i] = { key, i };
+    }
+    std::stable_sort(keys.begin(), keys.end());
+    std::vector<int> perm(nAtoms);
+    for (int i = 0; i < nAtoms; i++)
+    {
+        perm[i] = keys[i].second;
+    }
+    cudaMemcpy(d_perm, perm.data(), nAtoms * sizeof(int), cudaMemcpyHostToDevice);
+
+    struct Variant
+    {
+        const char* name;
+        int         interleave;
+        const int*  perm;
+        int         mode;
+    };
+    const Variant variants[] = { { "prod-order", 0, nullptr, 0 },
+                                 { "prod-order-again", 0, nullptr, 0 },
+                                 { "interleave", 1, nullptr, 0 },
+                                 { "cell-sorted", 0, d_perm, 0 },
+                                 { "cell-sorted+interleave", 1, d_perm, 0 },
+                                 { "ko-splines-only", 0, nullptr, 1 },
+                                 { "ko-stores-not-atomics", 0, nullptr, 2 },
+                                 { "ko-stores-not-atomics+cell-sorted", 0, d_perm, 2 } };
+    const int     nv         = sizeof(variants) / sizeof(variants[0]);
+    std::vector<PmeGpuKernelParams> params(nv, *kp);
+    for (int v = 0; v < nv; v++)
+    {
+        params[v].expSpreadInterleave        = variants[v].interleave;
+        params[v].expAtomPerm                = variants[v].perm;
+        params[v].expSpreadMode              = variants[v].mode;
+        params[v].grid.d_realGrid[FEP_STATE_A] = d_grid;
+    }
+    const DeviceStream& ds = pmeGpu->archSpecific->pmeStream_;
+    std::vector<std::vector<float>> grids(nv, std::vector<float>(gridSize));
+    for (int v = 0; v < nv; v++)
+    {
+        cudaMemsetAsync(d_grid, 0, gridSize * sizeof(float), stream);
+        const auto args = prepareGpuKernelArguments(kernelPtr, config, &params[v]);
+        launchGpuKernel(kernelPtr, config, ds, nullptr, "PME spread exp", args);
+        cudaMemcpyAsync(grids[v].data(), d_grid, gridSize * sizeof(float), cudaMemcpyDeviceToHost, stream);
+        cudaStreamSynchronize(stream);
+    }
+    std::vector<cudaEvent_t> ev(2 * nv * r.reps);
+    for (auto& e : ev)
+    {
+        cudaEventCreate(&e);
+    }
+    for (long rep = 0; rep < r.reps; rep++)
+    {
+        for (int v = 0; v < nv; v++)
+        {
+            const auto args = prepareGpuKernelArguments(kernelPtr, config, &params[v]);
+            cudaEventRecord(ev[2 * (rep * nv + v)], stream);
+            launchGpuKernel(kernelPtr, config, ds, nullptr, "PME spread exp", args);
+            cudaEventRecord(ev[2 * (rep * nv + v) + 1], stream);
+        }
+    }
+    cudaStreamSynchronize(stream);
+    double refSq = 0;
+    for (size_t i = 0; i < gridSize; i++)
+    {
+        refSq += double(grids[0][i]) * grids[0][i];
+    }
+    if (FILE* fp = std::fopen(r.file.c_str(), "a"))
+    {
+        for (int v = 0; v < nv; v++)
+        {
+            std::vector<float> t;
+            for (long rep = 0; rep < r.reps; rep++)
+            {
+                float ms = 0;
+                cudaEventElapsedTime(&ms, ev[2 * (rep * nv + v)], ev[2 * (rep * nv + v) + 1]);
+                t.push_back(ms * 1000.0F);
+            }
+            std::sort(t.begin(), t.end());
+            double dSq = 0;
+            for (size_t i = 0; i < gridSize; i++)
+            {
+                const double d = double(grids[v][i]) - grids[0][i];
+                dSq += d * d;
+            }
+            std::fprintf(fp,
+                         "replay call=%ld variant=%s reps=%ld median_us=%.3f p10_us=%.3f p90_us=%.3f min_us=%.3f "
+                         "f_rel_rms=%.3e f_max_abs=0 natoms=%d grid=%zu\n",
+                         r.calls, variants[v].name, r.reps, t[t.size() / 2], t[t.size() / 10],
+                         t[(t.size() * 9) / 10], t[0], refSq > 0 ? std::sqrt(dSq / refSq) : 0.0, nAtoms, gridSize);
+        }
+        std::fclose(fp);
+    }
+    for (auto& e : ev)
+    {
+        cudaEventDestroy(e);
+    }
+    cudaFree(d_grid);
+    cudaFree(d_perm);
+}
